# Microsoft Teams bot credentials (Azure Bot resource)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# Optional: Graph API scope override
TEAMS_GRAPH_SCOPE=https://graph.microsoft.com/.default

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SQLite
DB_PATH=./data/threads.db

# HTTP servers
# Webhook receiver for the Teams Bot Framework (must be publicly reachable, e.g. via ngrok)
TEAMS_WEBHOOK_PORT=3978
TEAMS_WEBHOOK_PATH=/api/messages

# Local HTTP API for CLI / external scripts
TEAMS_CORD_HTTP_PORT=2644
TEAMS_CORD_HTTP_HOST=127.0.0.1

# Claude Code spawner
CLAUDE_BIN=claude
CLAUDE_WORKING_DIR=
# Comma-separated allowlist of absolute paths the worker may cd into
TEAMS_CORD_ALLOWED_DIRS=

# Logging
LOG_LEVEL=info
